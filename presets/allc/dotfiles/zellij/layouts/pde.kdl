layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="terminal" focus=true {
        pane size="100%"
    }
    tab name="ide" {
        pane split_direction="vertical" {
            pane command="zsh" size="65%" {
                args "-lc" "${EDITOR:-nvim} .; exec \"$SHELL\" -l"
            }
            pane split_direction="horizontal" size="35%" {
                pane command="zsh" size="60%" {
                    args "-lc" "eval \"${AI_COMMAND_1:-codex}\"; exec \"$SHELL\" -l"
                }
                pane size="40%"
            }
        }
    }
    tab name="ide" {
        pane split_direction="vertical" {
            pane command="zsh" size="65%" {
                args "-lc" "${EDITOR:-nvim} .; exec \"$SHELL\" -l"
            }
            pane split_direction="horizontal" size="35%" {
                pane command="zsh" size="60%" {
                    args "-lc" "eval \"${AI_COMMAND_1:-codex}\"; exec \"$SHELL\" -l"
                }
                pane size="40%"
            }
        }
    }
    tab name="git" {
        pane command="zsh" size="100%" {
            args "-lc" "lazygit; exec \"$SHELL\" -l"
        }
    }
}
