#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET"
  fi
done
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

CHECK_ONLY=0
INSTALL_ONLY=0

usage() {
  echo "Usage:"
  echo "  pde-update"
  echo "  pde-update --check"
  echo "  pde-update --install-only"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      CHECK_ONLY=1
      shift
      ;;
    --install-only)
      INSTALL_ONLY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

cd "$REPO_DIR"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "PDE repo is not a git repository: $REPO_DIR" >&2
  exit 1
}

current_branch="$(git rev-parse --abbrev-ref HEAD)"
upstream_branch="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"

if [[ "$INSTALL_ONLY" -eq 0 ]]; then
  git fetch --all --prune
fi

behind_count=0
ahead_count=0
if [[ -n "$upstream_branch" ]]; then
  counts="$(git rev-list --left-right --count "HEAD...$upstream_branch")"
  read -r ahead_count behind_count <<<"$counts"
  ahead_count="${ahead_count:-0}"
  behind_count="${behind_count:-0}"
fi

echo "repo:      $REPO_DIR"
echo "branch:    $current_branch"
echo "upstream:  ${upstream_branch:-none}"
echo "ahead:     $ahead_count"
echo "behind:    $behind_count"

if [[ "$CHECK_ONLY" -eq 1 ]]; then
  exit 0
fi

if [[ "$INSTALL_ONLY" -eq 0 && -n "$upstream_branch" && "$behind_count" -gt 0 ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "Working tree has local changes. Commit or stash them before update." >&2
    exit 1
  fi
  git pull --ff-only
elif [[ "$INSTALL_ONLY" -eq 0 && -z "$upstream_branch" ]]; then
  echo "No upstream configured, skipping git pull."
fi

"$REPO_DIR/install.sh"

echo ""
echo "✓ PDE update complete"
